# Copy to .env and adjust for local development.
# Production default (no .env) is ~/.acr — see src/acr/config.py.

ACR_DATA_DIR=./data
ACR_LOG_LEVEL=INFO
ACR_LOG_FORMAT=console

# Optional — cloud providers are opt-in (master principle #2: cloud-optional).
# Unset by default; ACR runs fully local-first without either of these.
# ACR_OPENAI_API_KEY=
# ACR_ANTHROPIC_API_KEY=
